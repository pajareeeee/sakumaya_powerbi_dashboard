{
  "name": "SakumayaTheme",
  "dataColors": [
    "#1F4E79",
    "#2E86AB",
    "#F18F01",
    "#C73E1D",
    "#3B8EA5",
    "#8E7DBE",
    "#99C24D",
    "#6C757D"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A44",
  "tableAccent": "#1F4E79",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI"
    },
    "title": {
      "fontFace": "Segoe UI Semibold"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8F0"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#1F2A44"
              }
            },
            "fontSize": 12,
            "bold": true
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 22,
            "color": {
              "solid": {
                "color": "#1F4E79"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#5B6784"
              }
            }
          }
        ]
      }
    }
  }
}