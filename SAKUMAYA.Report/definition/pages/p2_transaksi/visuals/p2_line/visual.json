{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "p2_line",
  "position": {
    "x": 20,
    "y": 208,
    "z": 0,
    "width": 720,
    "height": 224
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Kalender"
                    }
                  },
                  "Property": "MonthStart"
                }
              },
              "queryRef": "Kalender.MonthStart",
              "nativeQueryRef": "MonthStart",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Volume Sukses (Rp M)"
                }
              },
              "queryRef": "_Measures.Volume Sukses (Rp M)",
              "nativeQueryRef": "Volume Sukses (Rp M)"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}