	partition cards = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\cards.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"card_id", type text}, {"customer_id", type text}, {"account_id", type text}, {"card_type", type text}, {"card_number_masked", type text}, {"expiry_date", type text}, {"status", type text}, {"credit_limit_idr", type number}, {"outstanding_idr", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table

