		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\loans.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"loan_id", type text}, {"customer_id", type text}, {"loan_type", type text}, {"principal_idr", Int64.Type}, {"interest_rate_annual", type number}, {"tenure_months", Int64.Type}, {"disbursement_date", type date}, {"monthly_installment_idr", Int64.Type}, {"outstanding_idr", Int64.Type}, {"status", type text}, {"due_date", type date}, {"last_payment_date", type date}}, "en-US")
