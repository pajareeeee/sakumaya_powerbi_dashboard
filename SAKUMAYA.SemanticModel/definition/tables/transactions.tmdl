	partition transactions = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\transactions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"trx_id", type text}, {"account_id", type text}, {"trx_type", type text}, {"amount_idr", Int64.Type}, {"merchant_name", type text}, {"merchant_category", type text}, {"trx_date", type date}, {"trx_time", type text}, {"balance_after_idr", Int64.Type}, {"status", type text}, {"channel", type text}}, "en-US"),
					AddHour = Table.AddColumn(Typed, "trx_hour", each Number.FromText(Text.Start([trx_time], 2)), Int64.Type)
				in
					AddHour

	annotation PBI_ResultType = Table

